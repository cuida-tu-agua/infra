{
	email {$ACME_EMAIL}
}

# Web app (nginx container)
{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

# API: /docs goes to Swagger UI, everything else to the gateway
{$API_DOMAIN} {
	encode zstd gzip
	handle /docs* {
		reverse_proxy swagger-ui:8080
	}
	handle {
		reverse_proxy api-gateway:8080
	}
}
