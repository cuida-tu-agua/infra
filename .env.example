# ═══ Paths ═══════════════════════════════════════════════════════════
# Folder with public.pem (+ private.pem for ms-iam).
# Local: the development keys of ms-iam.  Server: ./secrets/keys (new keys).
KEYS_DIR=../sy-water-backend/ms-iam/keys

# ═══ Public URLs ═════════════════════════════════════════════════════
# Gateway URL that the WEB uses (baked into the web image)
PUBLIC_API_URL=http://localhost:8080
# Web origin(s) allowed by the gateway (comma separated, no trailing slash)
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8081,http://localhost:19006,http://localhost:8083
# Base of the links inside the e-mails
APP_PUBLIC_URL=http://localhost:8082

# ═══ SQL Server ══════════════════════════════════════════════════════
# Locally, use the SAME app passwords you have in user-secrets / ms-iam .env,
# so you can also run a service from the IDE (section 13).
MSSQL_SA_PASSWORD=
SECURITY_APP_PASSWORD=
SECURITY_MIGRATOR_PASSWORD=
PLACES_APP_PASSWORD=
PLACES_MIGRATOR_PASSWORD=
DEVICES_APP_PASSWORD=
DEVICES_MIGRATOR_PASSWORD=
CONSUMPTION_APP_PASSWORD=
CONSUMPTION_MIGRATOR_PASSWORD=
VALVE_APP_PASSWORD=
VALVE_MIGRATOR_PASSWORD=
NOTIFICATION_APP_PASSWORD=
NOTIFICATION_MIGRATOR_PASSWORD=

# ═══ Brokers and shared keys ═════════════════════════════════════════
RABBITMQ_PASSWORD=
MQTT_MS_DEVICES_PASSWORD=
INTERNAL_API_KEY=

# ═══ E-mail ══════════════════════════════════════════════════════════
# Local (Mailpit): mailpit / 1025 / None / auth false / starttls false
# Server (Gmail):  smtp.gmail.com / 587 / StartTls / true / true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cuidatuagua.local

# ═══ Continuar con Google (HU-004) ═══════════════════════════════════
# OAuth client "Web application" of Google Cloud Console. Empty = the button is hidden.
# Authorized redirect URI in Google = PUBLIC_API_URL + /iam/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where ms-iam may send the result besides APP_PUBLIC_URL: the mobile app scheme and Expo Go
# (development web on Expo: add http://localhost:19006)
GOOGLE_EXTRA_REDIRECTS=saveyourwater:,exp:

# ═══ SMS / WhatsApp (HU-028) ═════════════════════════════════════════
# Critical alerts and the phone verification code. Local: empty = mailpit (each message is a mail in
# http://localhost:8025, no account needed). Server: twilio + the account below. Empty on the server = off.
SMS_PROVIDER=
# Twilio console → Account Info. The token is a secret: never in git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number that sends SMS (E.164, leave it EMPTY for WhatsApp only: an SMS costs US$0.06 to Colombia and US$0.34 to
# Ecuador) and the WhatsApp sender registered in Twilio (Messaging > Senders > WhatsApp senders)
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Content SID (HX…) of the approved WhatsApp templates (Twilio Content Template Builder): one with ONE variable {{1}}
# for alerts and invitations, and an Authentication one for the phone code. Empty = free text (only 24 h after the
# person wrote to the number).
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_CODE_TEMPLATE_SID=
# WhatsApp by the WhatsApp Cloud API of Meta (free test number for up to 5 recipients): meta = WhatsApp goes by Meta and
# SMS keeps SMS_PROVIDER. Meta app → WhatsApp → API Setup: "Phone number ID" and the access token (a secret: never in git).
WHATSAPP_PROVIDER=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Optional approved templates. META_TEMPLATE_NAME: Utility template with ONE variable {{1}} that receives the whole text
# (messages arrive at any time). Empty = free text, which WhatsApp only delivers 24 h after the person wrote to the number.
# META_CODE_TEMPLATE_NAME: Authentication template (code + copy button) for the phone code.
META_TEMPLATE_NAME=
META_CODE_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=es

# ═══ Production only (leave commented locally) ═══════════════════════
# COMPOSE_FILE=compose.yml:compose.prod.yml
# WEB_DOMAIN=cuidatuagua.duckdns.org
# API_DOMAIN=api.cuidatuagua.duckdns.org
# ACME_EMAIL=correo-del-equipo@ejemplo.com


# ── Producción: versión desplegada de cada imagen (la actualiza Jenkins) ──
MS_IAM_TAG=
MS_PLACES_TAG=
MS_DEVICE_TAG=
MS_CONSUMPTION_TAG=
MS_VALVE_TAG=
MS_NOTIFICATION_TAG=
API_GATEWAY_TAG=
WEB_TAG=    