# ═══ Paths ═══════════════════════════════════════════════════════════
# Folder with public.pem (+ private.pem for ms-iam).
# Local: the development keys of ms-iam.  Server: ./secrets/keys (new keys).
KEYS_DIR=../sy-water-backend/ms-iam/keys

# ═══ Public URLs ═════════════════════════════════════════════════════
# Gateway URL that the WEB uses (baked into the web image)
PUBLIC_API_URL=http://localhost:8080
# Web origin(s) allowed by the gateway (comma separated, no trailing slash)
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8081,http://localhost:19006,http://localhost:8083
# Base of the links inside the e-mails
APP_PUBLIC_URL=http://localhost:8082

# ═══ SQL Server ══════════════════════════════════════════════════════
# Locally, use the SAME app passwords you have in user-secrets / ms-iam .env,
# so you can also run a service from the IDE (section 13).
MSSQL_SA_PASSWORD=
SECURITY_APP_PASSWORD=
SECURITY_MIGRATOR_PASSWORD=
PLACES_APP_PASSWORD=
PLACES_MIGRATOR_PASSWORD=
DEVICES_APP_PASSWORD=
DEVICES_MIGRATOR_PASSWORD=
CONSUMPTION_APP_PASSWORD=
CONSUMPTION_MIGRATOR_PASSWORD=
VALVE_APP_PASSWORD=
VALVE_MIGRATOR_PASSWORD=
NOTIFICATION_APP_PASSWORD=
NOTIFICATION_MIGRATOR_PASSWORD=

# ═══ Brokers and shared keys ═════════════════════════════════════════
RABBITMQ_PASSWORD=
MQTT_MS_DEVICES_PASSWORD=
INTERNAL_API_KEY=

# ═══ E-mail ══════════════════════════════════════════════════════════
# Local (Mailpit): mailpit / 1025 / None / auth false / starttls false
# Server (Gmail):  smtp.gmail.com / 587 / StartTls / true / true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cuidatuagua.local

# ═══ Production only (leave commented locally) ═══════════════════════
# COMPOSE_FILE=compose.yml:compose.prod.yml
# WEB_DOMAIN=cuidatuagua.duckdns.org
# API_DOMAIN=api.cuidatuagua.duckdns.org
# ACME_EMAIL=correo-del-equipo@ejemplo.com
